{
  "name": "@skytree-photo-planner/server",
  "version": "0.1.0",
  "description": "Skytree Photo Planner Express Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec \"ts-node-esm --project tsconfig.json\" src/worker.ts",
    "build": "../../node_modules/@typescript/native/bin/tsc --project tsconfig.json",
    "start": "ts-node-esm --project tsconfig.json src/server.ts",
    "start:dev": "ts-node-esm --project tsconfig-node.json src/server.ts",
    "start:worker": "ts-node-esm --project tsconfig.json src/worker.ts",
    "start:worker:dev": "ts-node-esm --project tsconfig-node.json src/worker.ts",
    "worker": "ts-node-esm --project tsconfig.json src/worker.ts",
    "typecheck": "../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts",
    "prebuild": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "pretest": "npm run prisma:generate"
  },
  "dependencies": {
    "@skytree-photo-planner/types": "^0.1.0",
    "@skytree-photo-planner/utils": "^0.1.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.16",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "tsconfig-paths": "^4.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14"
  },
  "type": "module"
}
