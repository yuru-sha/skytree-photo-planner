{
  "name": "@skytree-photo-planner/server",
  "version": "0.1.0",
  "description": "Skytree Photo Planner Express Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec \"tsx --tsconfig tsconfig.json\" src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "tsx --tsconfig tsconfig.json src/server.ts",
    "start:dev": "tsx --tsconfig tsconfig-node.json src/server.ts",
    "start:worker": "tsx --tsconfig tsconfig.json src/worker.ts",
    "start:worker:dev": "tsx --tsconfig tsconfig-node.json src/worker.ts",
    "worker": "tsx --tsconfig tsconfig.json src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts",
    "prebuild": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "pretest": "npm run prisma:generate"
  },
  "dependencies": {
    "@skytree-photo-planner/types": "^0.1.0",
    "@skytree-photo-planner/utils": "^0.1.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.16",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsconfig-paths": "^4.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "type": "module"
}
