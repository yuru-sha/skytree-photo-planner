{
  "name": "skytree-photo-planner-monorepo",
  "version": "0.1.0",
  "description": "ダイヤモンドスカイツリーとパールスカイツリーのカレンダーアプリケーション - モノレポ構成",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\" \"npm run dev:worker\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:worker": "npm run dev:worker --workspace=apps/server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=apps/client",
    "build:server": "npm run build --workspace=apps/server",
    "build:packages": "npm run build --workspace=packages/types && npm run build --workspace=packages/utils && npm run build --workspace=packages/ui",
    "start": "npm run start --workspace=apps/server",
    "start:worker": "npm run start:worker --workspace=apps/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "worker": "npm run worker --workspace=apps/server",
    "create-admin": "node scripts/admin/create-admin.js",
    "init-system-settings": "node scripts/init-system-settings.js",
    "check-circular": "dpdm --exclude 'node_modules|generated/prisma' --no-tree --no-warning --exit-code circular:1 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "dependency-graph": "dpdm --exclude 'node_modules|generated/prisma' --no-warning --no-circular --output dependency-graph.json 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "analyze-deps": "dpdm --exclude 'node_modules|generated/prisma' --group-by-package --no-warning 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "analyze-deps-json": "dpdm --exclude 'node_modules|generated/prisma' --no-warning --output dependency-analysis.json 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.{ts,tsx}'",
    "validate-architecture": "node scripts/architecture/validate.js",
    "analyze-bundle": "node scripts/performance/analyze-bundle.js",
    "performance-budget": "node scripts/performance/performance-budget.js",
    "performance-check": "npm run analyze-bundle && npm run performance-budget && npm run analyze-deps",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.ts"
  },
  "keywords": [
    "fuji",
    "calendar",
    "photography",
    "diamond-fuji",
    "pearl-fuji",
    "monorepo"
  ],
  "author": "yuru-sha",
  "license": "MIT",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^5.4.3",
    "dpdm": "^4.3.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "terser": "^5.51.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "typescript": "^7.0.2",
    "@types/express": "^5.0.6"
  },
  "engines": {
    "node": ">=26.10.0",
    "npm": ">=11.19.1"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  }
}
